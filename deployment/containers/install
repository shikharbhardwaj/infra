#!/usr/bin/env python3

import argparse
import fnmatch
import hashlib
import json
import logging
import os
import pathlib
import re
import shutil
import sys
import yaml
import subprocess

# --- Configuration ---
TARGET_BASE_DIR = pathlib.Path.home() / "containers"
SYSTEMD_CONFIG_DIR = pathlib.Path.home() / ".config" / "containers" / "systemd"
SECRET_PLACEHOLDER_PATTERN = re.compile(r"\{\{\s*(\w+)\s*\}\}")
# Placeholder committed into otherwise-empty bind-mount dirs so git tracks
# them in the source tree (git ignores empty dirs). It has no purpose in the
# rendered target - the dir itself is what install must create - and copying
# it into a data dir owned by the container's mapped UID (rootless :U mounts)
# fails with EACCES, so it is skipped during rendering.
GIT_DIR_PLACEHOLDER = "empty-file-so-git-tracks-this-dir.txt"
# Sidecar digests let install decide whether a podman secret's value actually
# changed (podman deliberately never exposes a secret's value for comparison).
# Keyed by secret name -> sha256 of the value last written. Used only to avoid
# needless secret recreation + container restarts on unchanged pushes.
SECRET_DIGEST_DIR = SYSTEMD_CONFIG_DIR / ".secret-digests"
DEFAULT_SECRETS_FILE = "secrets.yml"
DEFAULT_INVENTORY_FILE = None  # No default - must be explicitly specified or use --all

# --- Set up logging ---
logging.basicConfig(
    level=logging.INFO, format="%(asctime)s [%(levelname)-4s] %(message)s"
)
logger = logging.getLogger(__name__)

# --- Helper Functions ---


def substitute_secrets(content: str, secrets: dict) -> str:
    """Substitutes {{ secret_name }} placeholders in content."""

    def replace_match(match):
        secret_name = match.group(1)
        if secret_name in secrets:
            return str(secrets[secret_name])
        else:
            # Keep the placeholder if the secret is not found, log a warning
            logger.warning(f"Secret '{secret_name}' not found in secrets file.")
            return match.group(0)  # Return the original placeholder

    return SECRET_PLACEHOLDER_PATTERN.sub(replace_match, content)


def is_likely_text_file(file_path: pathlib.Path) -> bool:
    """Tries to detect if a file is likely text-based (UTF-8)."""
    try:
        # Try reading a small chunk to detect encoding errors early
        with open(file_path, "r", encoding="utf-8") as f:
            f.read(1024)  # Read first 1KB
        return True
    except UnicodeDecodeError:
        return False
    except Exception as e:
        # Handle other potential read errors if necessary
        logger.warning(f"Could not read file {file_path} to check if text: {e}")
        return False  # Assume binary if unsure


def load_render_exclude(container_dir: pathlib.Path) -> list:
    """Reads a container's config.yml `render_exclude` list, if any.

    These are glob patterns (relative to the container dir) for files that
    must be copied verbatim, WITHOUT {{ }} secret substitution - e.g. Grafana
    dashboard JSON, whose {{label}} legend syntax collides with our
    {{ secret }} placeholder syntax. Such files contain no secrets.
    """
    config_file = container_dir / "config.yml"
    if not config_file.exists():
        return []
    try:
        with open(config_file, "r") as f:
            config = yaml.safe_load(f)
    except (yaml.YAMLError, IOError):
        return []
    if isinstance(config, dict):
        patterns = config.get("render_exclude", [])
        if isinstance(patterns, list):
            return [str(p) for p in patterns]
    return []


def is_render_excluded(
    file_path: pathlib.Path, container_dir: pathlib.Path, patterns: list
) -> bool:
    """True if file_path matches any render_exclude glob for its container."""
    if not patterns:
        return False
    rel = file_path.relative_to(container_dir).as_posix()
    return any(fnmatch.fnmatch(rel, pat) for pat in patterns)


def load_inventory(inventory_path: pathlib.Path, hostname: str) -> set:
    """Loads inventory file and returns set of containers for the given hostname."""
    if not inventory_path.exists():
        return None

    try:
        with open(inventory_path, "r") as f:
            inventory = yaml.safe_load(f)

        if not isinstance(inventory, dict):
            logger.error(
                f"Inventory file {inventory_path} must contain a YAML dictionary."
            )
            sys.exit(1)

        # Check if hostname is in inventory
        if hostname in inventory:
            containers = inventory[hostname]
            if isinstance(containers, list):
                return set(containers)
            else:
                logger.error(
                    f"Containers for hostname '{hostname}' must be a list in inventory file."
                )
                sys.exit(1)
        else:
            logger.warning(
                f"Hostname '{hostname}' not found in inventory. No containers will be installed."
            )
            logger.info(f"Available hosts in inventory: {', '.join(inventory.keys())}")
            return set()

    except yaml.YAMLError as e:
        logger.error(f"Error parsing inventory file {inventory_path}: {e}")
        sys.exit(1)
    except IOError as e:
        logger.error(f"Could not read inventory file {inventory_path}: {e}")
        sys.exit(1)


def find_missing_placeholders(
    script_dir: pathlib.Path, allowed_containers, secrets: dict
) -> dict:
    """Scans container directories for {{ var }} placeholders that have no
    matching key in the loaded secrets, without modifying anything.

    Returns a dict of container_name -> set of missing variable names.
    """
    missing_by_container = {}

    for item in script_dir.iterdir():
        if not item.is_dir() or item.name.startswith("."):
            continue

        container_name = item.name
        if allowed_containers is not None and container_name not in allowed_containers:
            continue

        render_exclude = load_render_exclude(item)
        for root, _dirs, files in os.walk(item):
            for file_name in files:
                file_path = pathlib.Path(root) / file_name
                if is_render_excluded(file_path, item, render_exclude):
                    continue
                if not is_likely_text_file(file_path):
                    continue
                try:
                    content = file_path.read_text(encoding="utf-8")
                except (UnicodeDecodeError, IOError):
                    continue

                missing = {
                    match.group(1)
                    for match in SECRET_PLACEHOLDER_PATTERN.finditer(content)
                    if match.group(1) not in secrets
                }
                if missing:
                    missing_by_container.setdefault(container_name, set()).update(
                        missing
                    )

    return missing_by_container


def write_if_changed(target_file: pathlib.Path, new_bytes: bytes) -> bool:
    """Writes new_bytes to target_file only if the content differs from what is
    already there. Returns True if the file was created or its content changed.

    This is what makes deploys idempotent: an unchanged rendered file leaves the
    on-disk copy (and its mtime) untouched, so install can tell which containers
    actually need a restart and which can be left running.
    """
    if target_file.exists():
        try:
            if target_file.read_bytes() == new_bytes:
                return False
        except OSError:
            pass  # unreadable - fall through and rewrite
    target_file.parent.mkdir(parents=True, exist_ok=True)
    target_file.write_bytes(new_bytes)
    return True


def ensure_podman_secrets(
    container_name: str, podman_secrets: list, secrets: dict
) -> bool:
    """Ensures each podman secret exists with the current value. Returns True if
    any secret was created or its value changed (meaning the container must be
    restarted to pick it up).

    podman never exposes a secret's value, so to avoid recreating (and thus
    forcing a restart of) unchanged secrets on every push, we compare against a
    sidecar sha256 digest written the last time we set it. A secret is
    (re)created only when it is missing from podman or its value's digest
    differs.
    """
    changed = False
    for secret_name in podman_secrets:
        if secret_name not in secrets:
            logger.error(
                f"Required secret '{secret_name}' for container '{container_name}' not found in secrets file."
            )
            sys.exit(1)

        value = str(secrets[secret_name])
        digest = hashlib.sha256(value.encode("utf-8")).hexdigest()
        digest_file = SECRET_DIGEST_DIR / secret_name

        # Does podman already hold this secret?
        try:
            secret_exists = (
                subprocess.run(
                    ["podman", "secret", "inspect", secret_name],
                    capture_output=True,
                    text=True,
                ).returncode
                == 0
            )
        except Exception as e:
            logger.error(f"Failed to check if secret '{secret_name}' exists: {e}")
            sys.exit(1)

        prev_digest = None
        if digest_file.exists():
            try:
                prev_digest = digest_file.read_text(encoding="utf-8").strip()
            except OSError:
                prev_digest = None

        if secret_exists and prev_digest == digest:
            logger.debug(f"Secret '{secret_name}' unchanged, leaving as-is.")
            continue

        # (Re)create: value changed, secret missing, or digest unknown.
        if secret_exists:
            logger.debug(f"Removing existing secret '{secret_name}' to update it")
            try:
                subprocess.run(["podman", "secret", "rm", secret_name], check=True)
            except subprocess.CalledProcessError as e:
                logger.error(f"Failed to remove existing secret '{secret_name}': {e}")
                sys.exit(1)

        logger.info(f"Creating podman secret: {secret_name}")
        try:
            create_cmd = ["podman", "secret", "create", secret_name, "-"]
            process = subprocess.Popen(create_cmd, stdin=subprocess.PIPE, text=True)
            process.communicate(input=value)
            if process.returncode != 0:
                logger.error(f"Failed to create secret '{secret_name}'")
                sys.exit(1)
        except Exception as e:
            logger.error(f"Error creating secret '{secret_name}': {e}")
            sys.exit(1)

        SECRET_DIGEST_DIR.mkdir(parents=True, exist_ok=True)
        digest_file.write_text(digest, encoding="utf-8")
        changed = True

    return changed


# --- Main Logic ---


def main():
    parser = argparse.ArgumentParser(
        description="Installs container configurations, substituting secrets.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "--secrets",
        type=pathlib.Path,
        default=DEFAULT_SECRETS_FILE,
        help="Path to the secrets.yml file.",
    )
    parser.add_argument(
        "--inventory",
        type=pathlib.Path,
        default=DEFAULT_INVENTORY_FILE,
        help="Path to the inventory.yml file.",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Install all containers, ignoring inventory file.",
    )
    parser.add_argument(
        "--restart",
        "-r",
        action="store_true",
        help="Restart only containers whose rendered config or secrets changed.",
    )
    parser.add_argument(
        "--restart-all",
        action="store_true",
        help="Force-restart every installed container regardless of changes "
        "(implies --restart). Use for recovery or to pick up image updates.",
    )
    parser.add_argument(
        "--verbose", "-v", action="store_true", help="Enable verbose (debug) logging"
    )
    args = parser.parse_args()

    # Set logging level based on verbosity
    if args.verbose:
        logger.setLevel(logging.DEBUG)

    script_dir = pathlib.Path(__file__).parent.resolve()
    secrets_path = args.secrets
    inventory_path = args.inventory

    # --- Get hostname and load inventory ---
    current_hostname = os.uname().nodename
    logger.info(f"Current hostname: {current_hostname}")

    allowed_containers = None
    if not args.all:
        if inventory_path is None:
            logger.error(
                "No inventory file specified. Either provide --inventory <path> or use --all to install all containers."
            )
            sys.exit(1)
        allowed_containers = load_inventory(inventory_path, current_hostname)
        if allowed_containers is None:
            logger.error(f"Inventory file not found at {inventory_path}.")
            sys.exit(1)
        elif len(allowed_containers) == 0:
            logger.info("No containers to install for this host.")
        else:
            logger.info(
                f"Containers to install: {', '.join(sorted(allowed_containers))}"
            )
    else:
        logger.info("Installing all containers (--all flag specified).")

    # --- Load Secrets ---
    secrets = {}
    if secrets_path.exists():
        logger.info(f"Loading secrets from: {secrets_path}")
        try:
            with open(secrets_path, "r") as f:
                secrets = yaml.safe_load(f)
                if not isinstance(secrets, dict):
                    logger.error(
                        f"Secrets file {secrets_path} must contain a YAML dictionary (key-value pairs)."
                    )
                    sys.exit(1)
        except yaml.YAMLError as e:
            logger.error(f"Error parsing secrets file {secrets_path}: {e}")
            sys.exit(1)
        except IOError as e:
            logger.error(f"Could not read secrets file {secrets_path}: {e}")
            sys.exit(1)
    else:
        logger.info(
            f"Secrets file not found at {secrets_path}. Proceeding without secret substitution."
        )

    # --- Pre-flight: fail loudly on unresolvable {{ var }} placeholders ---
    # Without this, an unsubstituted placeholder gets silently written into a
    # live config (e.g. a quadlet file), which only surfaces later as an
    # unrelated-looking error (e.g. systemd "Unit not found").
    missing_by_container = find_missing_placeholders(
        script_dir, allowed_containers, secrets
    )
    if missing_by_container:
        logger.error(
            f"Missing secrets required to render config files (add these to {secrets_path}):"
        )
        for container_name, missing_vars in sorted(missing_by_container.items()):
            logger.error(f"  {container_name}: {', '.join(sorted(missing_vars))}")
        sys.exit(1)

    # --- Ensure Target Base Directory Exists ---
    logger.info(f"Ensuring target base directory exists: {TARGET_BASE_DIR}")
    TARGET_BASE_DIR.mkdir(parents=True, exist_ok=True)

    # --- Process Container Subdirectories ---
    logger.info(f"Searching for container directories in: {script_dir}")
    found_containers = False
    containers = []
    changed_containers = set()  # names whose rendered config or secrets changed
    for item in script_dir.iterdir():
        if item.is_dir() and not item.name.startswith(
            "."
        ):  # Basic check for container dir
            container_name = item.name

            # Check if this container should be installed based on inventory
            if (
                allowed_containers is not None
                and container_name not in allowed_containers
            ):
                logger.debug(
                    f"Skipping container '{container_name}' (not in inventory for this host)"
                )
                continue

            containers.append(container_name)
            source_dir = item
            target_dir = TARGET_BASE_DIR / container_name
            found_containers = True

            logger.info(f"Processing container '{container_name}':")
            logger.debug(f"  Source: {source_dir}")
            logger.debug(f"  Target: {target_dir}")

            # --- Read container's config.yml if it exists ---
            config_file = source_dir / "config.yml"
            if config_file.exists():
                try:
                    with open(config_file, "r") as f:
                        config = yaml.safe_load(f)

                    # Process podman_secrets configuration
                    if (
                        config
                        and isinstance(config, dict)
                        and "podman_secrets" in config
                    ):
                        podman_secrets_list = config.get("podman_secrets", [])
                        if podman_secrets_list and isinstance(
                            podman_secrets_list, list
                        ):
                            if secrets:
                                if ensure_podman_secrets(
                                    container_name, podman_secrets_list, secrets
                                ):
                                    changed_containers.add(container_name)
                            else:
                                logger.error(
                                    f"Container '{container_name}' requires secrets but no secrets file was loaded."
                                )
                                sys.exit(1)
                except yaml.YAMLError as e:
                    logger.error(f"Error parsing config file {config_file}: {e}")
                    sys.exit(1)
                except IOError as e:
                    logger.error(f"Could not read config file {config_file}: {e}")
                    sys.exit(1)

            render_exclude = load_render_exclude(source_dir)

            target_dir.mkdir(parents=True, exist_ok=True)

            # --- Walk Source Directory and Copy/Substitute ---
            for root, dirs, files in os.walk(source_dir):
                source_root = pathlib.Path(root)
                relative_path = source_root.relative_to(source_dir)
                target_root = target_dir / relative_path

                # Create directories
                for dir_name in dirs:
                    source_subdir = source_root / dir_name
                    target_subdir = target_root / dir_name
                    if not target_subdir.exists():
                        logger.info(
                            f"    Creating dir:  {target_subdir.relative_to(TARGET_BASE_DIR)}"
                        )
                        target_subdir.mkdir()
                    # Preserve permissions on directories if needed (more complex)

                # Copy/Substitute files
                for file_name in files:
                    # Git-tracking placeholders exist only in the source tree;
                    # the dir they mark is already created above. Skip them -
                    # copying into a container-owned data dir fails with EACCES.
                    if file_name == GIT_DIR_PLACEHOLDER:
                        continue

                    source_file = source_root / file_name
                    target_file = target_root / file_name
                    relative_file_path = target_file.relative_to(TARGET_BASE_DIR)

                    verbatim = is_render_excluded(
                        source_file, source_dir, render_exclude
                    )
                    if not secrets or verbatim or not is_likely_text_file(source_file):
                        # Copy binary files, render-excluded files (e.g. Grafana
                        # dashboards whose {{label}} syntax is not ours), or when
                        # no secrets are loaded.
                        try:
                            new_bytes = source_file.read_bytes()
                        except OSError as e:
                            logger.error(f"Failed reading {source_file}: {e}")
                            sys.exit(1)
                        if write_if_changed(target_file, new_bytes):
                            logger.info(f"    Copying:     {relative_file_path}")
                            shutil.copymode(source_file, target_file)
                            changed_containers.add(container_name)
                        else:
                            logger.debug(f"    Unchanged:   {relative_file_path}")
                    else:
                        # Read, substitute, and write text files
                        try:
                            with open(source_file, "r", encoding="utf-8") as sf:
                                content = sf.read()

                            substituted_content = substitute_secrets(content, secrets)

                            if write_if_changed(
                                target_file, substituted_content.encode("utf-8")
                            ):
                                logger.info(f"    Substituting: {relative_file_path}")
                                shutil.copymode(source_file, target_file)
                                changed_containers.add(container_name)
                            else:
                                logger.debug(f"    Unchanged:   {relative_file_path}")
                        except Exception as e:
                            logger.error(f"Failed processing file {source_file}: {e}")
                            sys.exit(1)

                    # Create symlinks for container files to systemd directory
                    if file_name.endswith(".container"):
                        # Ensure systemd directory exists
                        SYSTEMD_CONFIG_DIR.mkdir(parents=True, exist_ok=True)

                        systemd_link = SYSTEMD_CONFIG_DIR / file_name
                        # Only (re)create the symlink when it is missing or
                        # points elsewhere. A newly-linked unit is a brand-new
                        # service, so treat that as a change that needs a start.
                        already_linked = (
                            systemd_link.is_symlink()
                            and os.readlink(systemd_link) == str(target_file)
                        )
                        if not already_linked:
                            if systemd_link.exists() or systemd_link.is_symlink():
                                systemd_link.unlink()
                            logger.info(
                                f"    Creating symlink: {systemd_link} -> {target_file}"
                            )
                            try:
                                os.symlink(target_file, systemd_link)
                            except Exception as e:
                                logger.error(
                                    f"Failed to create symlink for {file_name}: {e}"
                                )
                                sys.exit(1)
                            changed_containers.add(container_name)

    if not found_containers:
        logger.info("No container subdirectories found.")
    else:
        # Reload systemd to recognize new services
        logger.info("Reloading systemd to recognize new services...")
        try:
            subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
            logger.info("Systemd reloaded successfully.")
        except subprocess.CalledProcessError as e:
            logger.error(f"Failed to reload systemd: {e}")
            sys.exit(1)

        if args.restart or args.restart_all:
            if args.restart_all:
                to_restart = list(containers)
                logger.info("Force-restarting all installed containers (--restart-all).")
            else:
                # Only recycle containers whose rendered config or secrets
                # actually changed - restarting unchanged ones (especially
                # traefik) is what caused an uptime dip on every push.
                to_restart = [c for c in containers if c in changed_containers]
                if not to_restart:
                    logger.info(
                        "No container config changed; nothing to restart."
                    )

            for container in to_restart:
                logger.info(f"Restart container: {container}")
                try:
                    subprocess.run(
                        ["systemctl", "--user", "restart", container], check=True
                    )
                    logger.info(f"Container {container} restarted successfully.")
                except subprocess.CalledProcessError as e:
                    logger.error(f"Failed to restart container {container}: {e}")
                    sys.exit(1)

    logger.info("Installation complete.")


if __name__ == "__main__":
    main()

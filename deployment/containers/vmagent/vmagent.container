[Unit]
Description=vmagent - scrapes fleet hosts' metrics over Tailscale, forwards to victoria-metrics
Wants=network.target
Requires=victoria-metrics.service
After=victoria-metrics.service

[Container]
ContainerName=vmagent
Image=docker.io/victoriametrics/vmagent:latest
AutoUpdate=registry

Network=web

# Point the container's resolver at Tailscale's MagicDNS ("quad 100")
# service so scrape.yml can use plain node names (arete, thor, ...) instead
# of per-host tailscale IPs - the container doesn't inherit tyr's own
# MagicDNS resolution automatically just because the host has it.
DNS=100.100.100.100

Volume=%h/containers/vmagent/scrape.yml:/etc/vmagent/scrape.yml:Z
Volume=%h/containers/vmagent/data:/vmagentdata:Z

Exec=--promscrape.config=/etc/vmagent/scrape.yml --remoteWrite.url=http://victoria-metrics:8428/api/v1/write

[Service]
Restart=always

[Install]
WantedBy=default.target

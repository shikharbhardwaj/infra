# Managed by ansible - playbooks/configure-netdata-streaming.yml
# (rendered from playbooks/templates/stream.conf.j2). Do not edit by hand;
# changes will be overwritten on the next playbook run.
{% if netdata_role == 'parent' %}
# {{ inventory_hostname }} is the netdata streaming parent - accepts pushes
# from arete/thor/saras (ansible-managed, this same playbook) and gliese
# (not ansible-managed - Windows/WSL2 - set up by hand instead, see
# CLAUDE.md's "Netdata monitoring" section).
[{{ netdata_stream_api_key }}]
    enabled = yes
    allow from = *
    default history = 3600
    default memory mode = dbengine
    health enabled by default = auto

# Retention length itself is controlled by netdata.conf's [db] section
# (dbengine multihost disk space MB) on this host, not here - size that to
# tyr's actual free disk rather than assuming headroom, see CLAUDE.md.
{% else %}
# {{ inventory_hostname }} streams to the parent on tyr.
[stream]
    enabled = yes
    destination = tyr:19999
    api key = {{ netdata_stream_api_key }}
    timeout seconds = 60
{% endif %}
